# ==============================================================================
# Inksight Backend Environment Variables Configuration Template
# Copy this file to `backend/.env` for local development or set in Cloud Host (Render/Railway)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Inksight"
API_V1_STR="/api/v1"
ENVIRONMENT="production"                    # "development" | "staging" | "production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-key"
JWT_SECRET_KEY="replace-with-another-secure-random-32-byte-hex-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
ENABLE_DEMO_ENDPOINTS=true                  # Set false in strict production

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# For Local SQLite:
# DATABASE_URL="sqlite:///./learngraph.db"
#
# For Supabase PostgreSQL (replace with your DB credentials from Supabase Dashboard):
# Note: Use Transaction pooler or Direct connection URL.
# If URL starts with postgres://, the backend automatically normalizes to postgresql+psycopg2://
DATABASE_URL="postgresql+psycopg2://postgres.your-project-ref:your-strong-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 4. Redis & Celery Background Task Queue
# ------------------------------------------------------------------------------
# For Upstash Redis (Serverless TLS Redis):
# Example: rediss://default:your-upstash-token@your-upstash-endpoint.upstash.io:6379
REDIS_URL="rediss://default:your-upstash-token@your-upstash-endpoint.upstash.io:6379"

# Celery Broker and Result Backend (Defaults to REDIS_URL if left unset)
CELERY_BROKER_URL="rediss://default:your-upstash-token@your-upstash-endpoint.upstash.io:6379"
CELERY_RESULT_BACKEND="rediss://default:your-upstash-token@your-upstash-endpoint.upstash.io:6379"
CELERY_TASK_ALWAYS_EAGER=false              # Set true for synchronous testing without Redis

# ------------------------------------------------------------------------------
# 5. Cloud Storage (Cloudflare R2 or AWS S3)
# ------------------------------------------------------------------------------
# "local" for local disk storage, "s3" for Cloudflare R2 / AWS S3
STORAGE_BACKEND="s3"

# Cloudflare R2 / AWS S3 credentials
AWS_ACCESS_KEY_ID="your-cloudflare-r2-or-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-cloudflare-r2-or-aws-secret-access-key"
AWS_REGION="auto"                           # "auto" for Cloudflare R2, or AWS region (e.g. "us-east-1")
S3_BUCKET_NAME="inksight-uploads"
# Cloudflare R2 Endpoint: https://<account_id>.r2.cloudflarestorage.com (Omit or set None for standard AWS S3)
S3_ENDPOINT_URL="https://your-account-id.r2.cloudflarestorage.com"

# Upload Constraints
UPLOAD_DIR="./uploads"                      # Local buffer / fallback directory
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_TYPES="application/pdf,image/jpeg,image/png"

# ------------------------------------------------------------------------------
# 6. OCR Pipeline Settings
# ------------------------------------------------------------------------------
# "mock" for zero-dependency cloud instances, "paddleocr" for local PaddleOCR GPU/CPU engine
OCR_PROVIDER="mock"
OCR_LOW_CONFIDENCE_THRESHOLD=0.6
PADDLEOCR_LANG="en"
PADDLEOCR_USE_ANGLE_CLS=true
PADDLEOCR_USE_GPU=false

# ------------------------------------------------------------------------------
# 7. AI Diagnostic Evaluation Engine (Groq / vLLM API)
# ------------------------------------------------------------------------------
# "vllm" uses OpenAI-compatible API (Groq / vLLM / OpenAI); "mock" uses deterministic local engine
EVALUATOR_PROVIDER="vllm"
VLLM_BASE_URL="https://api.groq.com/openai/v1"
VLLM_MODEL="llama-3.3-70b-versatile"
VLLM_API_KEY="gsk_your_groq_api_key_here"
VLLM_TIMEOUT_SECONDS=30.0
VLLM_TEMPERATURE=0.0
ENABLE_EVALUATOR_FALLBACK=true              # Gracefully falls back to mock if AI engine is unreachable

# ------------------------------------------------------------------------------
# 8. CORS Settings (Allowed Frontend Origins)
# ------------------------------------------------------------------------------
# Include your Vercel production and preview deployment URLs
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://inksight.vercel.app,https://inksight-frontend.vercel.app"
