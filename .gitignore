# ==============================================================================
# Inksight Root .gitignore
# Comprehensive security and build artifact exclusion
# ==============================================================================

# ------------------------------------------------------------------------------
# Python / Backend
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so

.venv/
venv/
ENV/
env/

# Databases
*.db
*.db*
*.sqlite
*.sqlite3
backend/*.db*

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Uploads & Temporary Media
uploads/
uploads/*
backend/uploads/
backend/uploads/*
backend/data/

# Celery
celerybeat-schedule
celerybeat.pid

# Python distribution / packaging
develop-eggs/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# Node / Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
build/
frontend/build/

# Frontend Environment & Local Overrides
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production

# ------------------------------------------------------------------------------
# OS & IDE
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# VSCode: ignore all except extensions.json
.vscode/*
!.vscode/extensions.json

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
